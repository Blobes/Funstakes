{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env.development", ".env.production"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SHELL_URL",
    "AUTH_URL",
    "POST_URL",
    "PLATFORM_URL",
    "NEXT_PUBLIC_CLOUDFLARE_UPLOAD_HOST",
    "NEXT_PUBLIC_APP_VERSION"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "format": {
      "cache": true,
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
