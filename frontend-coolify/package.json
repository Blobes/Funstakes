{
  "name": "funstakes",
  "version": "1.0.6",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.development -- turbo run dev",
    "build": "turbo run build",
    "start": "dotenv -e .env.development -- turbo run start",
    "git:deploy": "bash -c 'pnpm version patch --no-git-tag-version && git add package.json && git commit -m \"${1:-chore: bump version}\" && git push' _",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "clean": "pnpm -r exec rm -rf .next dist out",
    "clean:workspaces": "pnpm -r exec rm -rf node_modules .next dist out && rm -rf node_modules",
    "trans:extract": "dotenv -e .env.development -- pnpm dlx tsx locale/extractor.ts",
    "trans:translate": "dotenv -e .env.development -- pnpm dlx tsx locale/translator.ts --mode=translate-only",
    "trans:upload": "dotenv -e .env.development -- pnpm dlx tsx locale/translator.ts --mode=upload-only",
    "trans:translate-upload": "dotenv -e .env.development -- pnpm dlx tsx locale/translator.ts --mode=translate-and-upload",
    "trans:sync-all": "pnpm run trans:extract && pnpm run trans:translate",
    "link:locales": "ln -sf $(pwd)/locale/versions ./packages/assets/shared-public/locale"
  },
  "devDependencies": {
    "@types/wicg-file-system-access": "^2023.10.7",
    "dotenv-cli": "catalog:default",
    "next": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=9.0.7",
      "nanoid": ">=3.3.12"
    }
  }
}
