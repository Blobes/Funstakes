{
  "name": "@funstakes/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.development -- turbo run dev",
    "build": "dotenv -e .env.production -- turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "pnpm -r exec rm -rf dist out",
    "clean:workspaces": "pnpm -r exec rm -rf node_modules dist out && rm -rf node_modules",
    "sync:api-messages": "pnpm dlx tsx sync-api-msg.ts",
    "db:migrate": "dotenv -e .env.production -- pnpm dlx tsx packages/database/src/migration/migrateModels.ts",
    "db:sync-indexes": "dotenv -e .env.production -- pnpm dlx tsx packages/database/src/migration/syncIndexes.ts",
    "db:sync-topics": "dotenv -e .env.production -- pnpm dlx tsx packages/database/src/migration/syncTopics.ts",
    "db:remove-topic": "dotenv -e .env.production -- pnpm dlx tsx packages/database/src/migration/synctopic.ts --remove"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "tsc-alias": "catalog:",
    "tsconfig-paths": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18"
  }
}
